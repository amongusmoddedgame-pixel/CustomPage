<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Pastebin Viewer</title>

  <style>
    body{
      margin:0;
      height:100vh;
      display:flex;
      justify-content:center;
      align-items:center;
      background:black;
      font-family:Arial, sans-serif;
    }

    .box{
      background:#555;
      padding:30px;
      border-radius:20px;
      width:400px;
      text-align:center;
      box-shadow:0 0 20px rgba(255,255,255,0.1);
    }

    .title{
      color:white;
      font-size:28px;
      margin-bottom:15px;
      font-weight:bold;
    }

    .textbox{
      width:100%;
      height:120px;
      border:none;
      border-radius:10px;
      padding:15px;
      font-size:15px;
      resize:none;
      outline:none;
      background:#222;
      color:white;
      box-sizing:border-box;
    }

    .copy-btn{
      margin-top:15px;
      width:100%;
      padding:12px;
      border:none;
      border-radius:10px;
      background:#222;
      color:white;
      font-size:16px;
      cursor:pointer;
      transition:0.2s;
    }

    .copy-btn:hover{
      background:#111;
    }
  </style>
</head>
<body>

  <div class="box">

    <div class="title">Among Us Modded Game</div>

    <textarea id="pasteText" class="textbox" readonly>
Loading Game Code...
    </textarea>

    <button class="copy-btn" onclick="copyText()">
      Copy
    </button>
  </div>

  <script>
    // Pastebin RAW link
    const pastebinURL = "https://pastebin.com/raw/PASTE_ID_HERE";

    async function loadPastebin() {
      try {
        const response = await fetch(pastebinURL);
        const text = await response.text();

        document.getElementById("pasteText").value = text;
      } catch (error) {
        document.getElementById("pasteText").value =
          "Game Unavailable :/";
      }
    }

    function copyText() {
      const textbox = document.getElementById("pasteText");

      navigator.clipboard.writeText(textbox.value);

      alert("Copied, Paste in on among us");
    }

    loadPastebin();
  </script>

</body>
</html>
